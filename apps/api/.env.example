# Copy to .env for local overrides. Production values live in Vercel project settings.
ENV=development                 # "production" makes the API refuse unsafe defaults
DATABASE_URL=sqlite:///./healthy_lab.db
JWT_SECRET=                     # 32+ random characters; required in production
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=true              # false only for plain-http setups other than localhost
SEED_PASSWORD=                  # password for the demo accounts; required to seed production
